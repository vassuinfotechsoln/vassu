{
  "name": "vassutalks-backend",
  "version": "1.0.0",
  "description": "Real-time AI voice agent backend",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "restart": "powershell -Command \"Get-Process -Name node -ErrorAction SilentlyContinue | Stop-Process -Force; Start-Sleep -Seconds 1; node server.js\"",
    "kill": "powershell -Command \"Get-Process -Name node -ErrorAction SilentlyContinue | Stop-Process -Force; Write-Host 'All node processes killed'\"",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:db-push": "prisma db push"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.31.0",
    "@prisma/client": "^6.8.0",
    "assemblyai": "^4.22.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "form-data": "^4.0.5",
    "groq-sdk": "^0.37.0",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "uuid": "^13.0.0",
    "websocket": "^1.0.35",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "prisma": "^6.8.0"
  }
}
